# Copy to .env  (cp .env.example .env).  .env is git-ignored - NEVER commit real keys.

# --- LLM: any OpenAI-compatible endpoint. Defaults to Groq (get a key at console.groq.com) ---
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4.1-mini
#   Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=llama3.1   LLM_API_KEY=ollama

# --- Auth: >= 32 chars. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))" ---
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Docker/K8s secret files are supported for every secret: JWT_SECRET_FILE=/run/secrets/jwt_secret

# --- External MCP server (logistics) API key ---
EXTERNAL_MCP_API_KEY=logistics-dev-key

# --- Local (non-Docker) runs only; compose overrides these ---
DATABASE_URL=sqlite+aiosqlite:///./dev.db
LOG_LEVEL=INFO
